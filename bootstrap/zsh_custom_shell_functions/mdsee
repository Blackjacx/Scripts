# Markdown to HTML

# ~/.config/zsh/functions/mdsee
HTMLFILE="$(mktemp -u).html"
jq --slurp --raw-input '{"text": "\(.)", "mode": "markdown"}' "$1" |
    curl -s --data @- https://api.github.com/markdown >"$HTMLFILE"
echo "$HTMLFILE"
open "$HTMLFILE"

