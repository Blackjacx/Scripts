[core]
    excludesfile = ~/.gitignore
    mergeoptions = --no-edit
    pager = delta
    editor = nvim -c startinsert
[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false # required for git 2.37.0
[delta]
    navigate = true                 # n/N to jump between file diffs — huge for big diffs
    light = false
    line-numbers = true
    syntax-theme = gruvbox-dark
    hyperlinks = true               # cmd/ctrl-click a filename → opens in editor (if term supports it)
[diff]
    colorMoved = default            # delta highlights moved blocks distinctly from add/remove
[merge]
    ff = only
    conflictStyle = zdiff3
[user]
    name = Stefan Herold
    email = 794372+Blackjacx@users.noreply.github.com
    signingkey = DE546DEBFC1C1C01
[push]
    default = simple
[branch]
    autosetuprebase = always
[github]
    user = blackjacx
[ghi]
    token = !security find-internet-password -a blackjacx -s github.com -l 'ghi token' -w
[credential]
    helper = osxkeychain
[gpg]
    program = /usr/local/bin/gpg
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[pull]
    rebase = true
[rerere]
    enabled = true
[rebase]
    autosquash = true
    autoStash = true
[init]
    defaultBranch = main
[pager]
    diff = true
    log = true
[fetch]
    prune = true
[absorb]
    maxStack=30 # default: 10
